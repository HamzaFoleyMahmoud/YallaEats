@page
@model YallaEat.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YallaEat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --bg-color: #050a30;
            --card-bg: #000c3c;
            --accent-green: #2ecc71;
            --neon-glow: #2ecc71;
            --text-muted: #6c757d;
            --light-intensity: 0;
        }

        body {
            background-color: var(--bg-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
            margin: 0;
            padding: 40px 0;
            overflow-x: hidden;
            transition: background-color 0.5s ease;
        }

        body.light-on {
            background-color: #081045;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 60px;
            width: 100%;
            max-width: 1100px;
            padding: 20px;
            position: relative;
        }

        /* Lamp Scene */
        .lamp-scene {
            flex: 0.8;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            height: 500px;
        }

        .lamp-support {
            width: 4px;
            height: 50px;
            background: #1a1a1a;
            position: absolute;
            top: 0;
        }

        .lamp-head {
            width: 180px;
            height: 140px;
            background: #111;
            border-radius: 50% 50% 10% 10%;
            position: relative;
            margin-top: 50px;
            z-index: 10;
            border: 2px solid #222;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .lamp-head.on {
            background: #1a1a1a;
            border-color: var(--accent-green);
            box-shadow: 
                0 0 calc(10px * var(--light-intensity)) var(--neon-glow),
                inset 0 0 calc(20px * var(--light-intensity)) var(--neon-glow);
        }

        .lamp-mascot-img {
            width: 100px;
            opacity: 0.3;
            transition: all 0.3s ease;
            filter: grayscale(1);
        }

        .lamp-head.on .lamp-mascot-img {
            opacity: 1;
            filter: grayscale(0) drop-shadow(0 0 10px var(--neon-glow));
            animation: float 3s ease-in-out infinite;
        }

        .light-beam {
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 400px;
            background: radial-gradient(ellipse at top, rgba(46, 204, 113, 0.2), transparent 70%);
            clip-path: polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%);
            opacity: 0;
            transition: opacity 0.5s ease;
            pointer-events: none;
            z-index: 5;
        }

        .lamp-head.on + .light-beam {
            opacity: calc(0.2 * var(--light-intensity));
        }

        /* Pull Rope */
        .rope-container {
            position: absolute;
            top: 160px;
            right: 40px;
            cursor: pointer;
            z-index: 15;
            transition: transform 0.1s ease;
            user-select: none;
        }

        .rope {
            width: 2px;
            height: 120px;
            background: #444;
            margin: 0 auto;
            position: relative;
        }

        .rope-handle {
            width: 16px;
            height: 16px;
            background: #888;
            border-radius: 50%;
            margin-top: -2px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.5);
            border: 2px solid #555;
        }

        .rope-container.pulling {
            transform: translateY(25px);
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }

        .register-card {
            flex: 1.2;
            background-color: var(--card-bg);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 0 40px rgba(46, 204, 113, 0.15), inset 0 0 2px rgba(255,255,255,0.1);
            border: 2px solid var(--neon-glow);
            position: relative;
            max-width: 600px;
            z-index: 20;
        }

        .welcome-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 30px;
            text-align: center;
            color: #fff;
            text-shadow: 0 0 10px rgba(255,255,255,0.3);
        }

        .form-label {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 6px;
            display: block;
        }

        .form-control, .form-select {
            background-color: rgba(5, 10, 48, 0.8);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 10px 16px;
            color: white !important;
            margin-bottom: 15px;
        }

        .form-control:focus, .form-select:focus {
            background-color: rgba(5, 10, 48, 1);
            border-color: var(--neon-glow);
            box-shadow: 0 0 10px rgba(46, 204, 113, 0.3);
            outline: none;
        }

        .form-select option {
            background-color: var(--card-bg);
            color: white;
        }

        .btn-register {
            background-color: var(--accent-green);
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 700;
            color: var(--bg-color);
            width: 100%;
            font-size: 1.1rem;
            margin-top: 10px;
            transition: all 0.3s ease;
        }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(46, 204, 113, 0.4);
            background-color: #27ae60;
            color: #fff;
        }

        .login-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #3d466e;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .login-link:hover {
            color: var(--neon-glow);
        }

        .validation-summary {
            color: #ff4757;
            font-size: 0.85rem;
            margin-bottom: 15px;
            list-style: none;
            padding: 0;
            text-align: center;
        }

        @@media (max-width: 992px) {
            .lamp-scene { display: none; }
            .auth-container { justify-content: center; }
            body { padding: 20px 0; }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="lamp-scene">
            <div class="lamp-support"></div>
            <div class="lamp-head" id="lampHead">
                <img src="~/images/lamp-mascot.png" alt="YallaEat Mascot" class="lamp-mascot-img" />
            </div>
            <div class="light-beam" id="lightBeam"></div>
            
            <div class="rope-container" id="ropeContainer">
                <div class="rope"></div>
                <div class="rope-handle"></div>
            </div>
        </div>

        <div class="register-card">
            <h1 class="welcome-title">Join YallaEat</h1>
            
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="All" class="validation-summary"></div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-2">
                            <label asp-for="Input.FirstName" class="form-label"></label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-2">
                            <label asp-for="Input.LastName" class="form-label"></label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" placeholder="Email Address" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Input.Role" class="form-label">Register As</label>
                    <select asp-for="Input.Role" class="form-select">
                        <option value="Customer">Customer (Ordering Food)</option>
                        <option value="Owner">Restaurant Owner</option>
                    </select>
                    <span asp-validation-for="Input.Role" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-2">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" type="password" placeholder="Password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Confirm" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-register">Create Account</button>

                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="login-link">Already have an account? Log in</a>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            let intensity = 0;
            const maxIntensity = 5;
            const lampHead = $('#lampHead');
            const rope = $('#ropeContainer');
            const body = $('body');

            rope.on('mousedown touchstart', function() {
                rope.addClass('pulling');
            });

            $(document).on('mouseup touchend', function() {
                if (rope.hasClass('pulling')) {
                    rope.removeClass('pulling');
                    pullLamp();
                }
            });

            function pullLamp() {
                if (intensity === 0) {
                    intensity = 1;
                    lampHead.addClass('on');
                    body.addClass('light-on');
                } else {
                    intensity++;
                    if (intensity > maxIntensity) {
                        intensity = 0;
                        lampHead.removeClass('on');
                        body.removeClass('light-on');
                    }
                }
                
                document.documentElement.style.setProperty('--light-intensity', intensity);
                
                lampHead.css('transform', 'translateY(5px)');
                setTimeout(() => {
                    lampHead.css('transform', 'translateY(0)');
                }, 100);
            }
        });
    </script>
</body>
</html>

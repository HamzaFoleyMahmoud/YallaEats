@model YallaEat.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container my-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <div class="display-1 text-success mb-3">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h1 class="fw-bold">Order Confirmed!</h1>
                <p class="text-muted lead">Your order #@Model.Id has been placed and is being processed.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">Order Details</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="px-4">Item</th>
                                    <th>Quantity</th>
                                    <th class="text-end px-4">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <h6 class="mb-0 fw-bold">@item.MenuItem?.Name</h6>
                                            <small class="text-muted">@item.MenuItem?.Restaurant?.Name</small>
                                        </td>
                                        <td>@item.Quantity</td>
                                        <td class="text-end px-4 fw-bold">$@((item.Quantity * item.PriceAtTimeOfOrder).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="2" class="text-end px-4 py-3 fw-bold">Total Amount</td>
                                    <td class="text-end px-4 py-3 fw-bold text-primary fs-5">$@Model.TotalAmount.ToString("0.00")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Delivery Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small uppercase">Address</p>
                        <p class="fw-semibold">@Model.DeliveryAddress</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small uppercase">Status</p>
                        <span class="badge bg-primary rounded-pill px-3">@Model.Status</span>
                    </div>
                </div>
            </div>

            <div class="text-center mt-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-sm">Back to Home</a>
            </div>
        </div>
    </div>
</div>

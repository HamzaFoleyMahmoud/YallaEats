@model YallaEat.Models.Restaurant

@{
    ViewData["Title"] = "Manage Menu - " + Model.Name;
}

<div class="container mt-5 pt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manage Menu</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <p class="text-muted"><i class="fa-solid fa-utensils me-2"></i>Menu Management</p>
        </div>
        <a asp-controller="MenuItems" asp-action="Create" asp-route-restaurantId="@Model.Id" class="btn btn-primary rounded-pill px-4">
            <i class="fa-solid fa-plus me-2"></i>Add New Dish
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4">Dish</th>
                        <th>Price</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MenuItems != null && Model.MenuItems.Any())
                    {
                        foreach (var item in Model.MenuItems)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded me-3 bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                <i class="fa-solid fa-utensils text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold">@item.Name</h6>
                                            <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">@item.Description</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-bold text-primary">$@item.Price.ToString("0.00")</td>
                                <td class="text-end px-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="MenuItems" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                        </a>
                                        <form asp-controller="MenuItems" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete @item.Name?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fa-solid fa-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-plate-wheat fa-3x mb-3 opacity-25"></i>
                                <p>No dishes found. Start by adding your first dish!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

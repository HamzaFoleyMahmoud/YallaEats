@model YallaEat.Models.Restaurant

@{
    ViewData["Title"] = Model.Name + " - Menu";
    var averageRating = Model.Reviews != null && Model.Reviews.Any() 
        ? Model.Reviews.Average(r => r.Rating) 
        : 0;
}

<div class="restaurant-details-header" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center; padding: 100px 0; color: white;">
    <div class="container text-center">
        <h1 class="display-3 fw-bold mb-3">@Model.Name</h1>
        <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
            <span class="badge bg-warning text-dark fs-5"><i class="fa-solid fa-star me-1"></i> @averageRating.ToString("0.0") (@Model.Reviews?.Count() reviews)</span>
            <span class="fs-5"><i class="fa-solid fa-map-pin me-1"></i> @Model.City, @Model.Address</span>
        </div>
        <p class="lead max-width-700 mx-auto">@Model.Description</p>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <!-- Menu Section -->
        <div class="col-lg-8">
            <h2 class="fw-bold mb-4 border-bottom pb-2">Menu</h2>
            
            @if (Model.MenuItems != null && Model.MenuItems.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model.MenuItems)
                    {
                        <div class="col-12">
                            <div class="card border-0 shadow-sm hover-lift mb-3">
                                <div class="row g-0">
                                    <div class="col-md-3">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="img-fluid rounded-start h-100 object-fit-cover" alt="@item.Name" style="min-height: 120px;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center h-100 rounded-start" style="min-height: 120px;">
                                                <i class="fa-solid fa-utensils fa-2x text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-9">
                                        <div class="card-body d-flex flex-column h-100">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title fw-bold mb-0">@item.Name</h5>
                                                <span class="text-primary fw-bold fs-5">$@item.Price.ToString("0.00")</span>
                                            </div>
                                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="align-self-end mt-2">
                                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                                    <div class="input-group input-group-sm mb-2" style="width: 100px;">
                                                        <input type="number" name="quantity" value="1" min="1" class="form-control rounded-start" />
                                                    </div>
                                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">Add to Cart</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary btn-sm rounded-pill px-4 align-self-end mt-2">Login to Order</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-light rounded-4">
                    <i class="fa-solid fa-clipboard-list fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">This restaurant hasn't added any menu items yet.</h4>
                </div>
            }
        </div>

        <!-- Sidebar (Info & Reviews) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 mb-4 rounded-4">
                <h4 class="fw-bold mb-3">Info</h4>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><i class="fa-solid fa-clock me-2 text-primary"></i> 10:00 AM - 11:00 PM</li>
                    <li class="mb-2"><i class="fa-solid fa-truck me-2 text-primary"></i> Delivery: 30-45 mins</li>
                    <li><i class="fa-solid fa-wallet me-2 text-primary"></i> Min. Order: $10.00</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h4 class="fw-bold mb-3">Reviews</h4>
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews.Take(5))
                    {
                        <div class="mb-3 pb-3 border-bottom last-child-no-border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold">@(review.User?.UserName?.Split('@')[0] ?? "Guest")</span>
                                <span class="text-warning small">
                                    @for(int i=0; i<5; i++) {
                                        <i class="fa-@(i < review.Rating ? "solid" : "regular") fa-star"></i>
                                    }
                                </span>
                            </div>
                            <p class="small text-muted mb-0 italic">"@review.Comment"</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No reviews yet. Be the first to order!</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .object-fit-cover { object-fit: cover; }
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .max-width-700 { max-width: 700px; }
    .last-child-no-border:last-child { border-bottom: none !important; }
</style>

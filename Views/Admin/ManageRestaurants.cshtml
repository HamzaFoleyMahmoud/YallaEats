@model IEnumerable<YallaEat.Models.Restaurant>

@{
    ViewData["Title"] = "Manage Restaurants";
}

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-utensils text-success me-2"></i>Global Restaurant Management</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to Admin Panel</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4">Restaurant</th>
                        <th>Owner</th>
                        <th>Location</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var restaurant in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="@restaurant.ImageUrl" class="rounded me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold">@restaurant.Name</div>
                                        <small class="text-muted">@restaurant.City</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small">@restaurant.Owner?.FirstName @restaurant.Owner?.LastName</div>
                                <div class="text-muted small">@restaurant.Owner?.Email</div>
                            </td>
                            <td>@restaurant.Address</td>
                            <td class="text-end px-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Restaurants" asp-action="Details" asp-route-id="@restaurant.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                                    <form asp-controller="Restaurants" asp-action="Delete" asp-route-id="@restaurant.Id" method="post" onsubmit="return confirm('Global Delete?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

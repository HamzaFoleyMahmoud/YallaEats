@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-5 pt-4">
    <h1 class="fw-bold mb-4 text-danger"><i class="fa-solid fa-user-shield me-2"></i>Admin Control Panel</h1>
    
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center hover-lift">
                <i class="fa-solid fa-users fa-3x text-primary mb-3"></i>
                <h4 class="fw-bold">User Management</h4>
                <p class="text-muted">Manage all registered customers and restaurant owners.</p>
                <a asp-action="ManageUsers" class="btn btn-outline-primary rounded-pill w-100">Manage Users</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center hover-lift">
                <i class="fa-solid fa-utensils fa-3x text-success mb-3"></i>
                <h4 class="fw-bold">Restaurants</h4>
                <p class="text-muted">Approve, remove, or edit any restaurant on the platform.</p>
                <a asp-action="ManageRestaurants" class="btn btn-outline-success rounded-pill w-100">Manage Restaurants</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center hover-lift">
                <i class="fa-solid fa-receipt fa-3x text-warning mb-3"></i>
                <h4 class="fw-bold">All Orders</h4>
                <p class="text-muted">Oversee every transaction and order status in the system.</p>
                <a asp-action="AllOrders" class="btn btn-outline-warning rounded-pill w-100">View All Orders</a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift { transition: transform 0.2s; }
    .hover-lift:hover { transform: translateY(-10px); }
</style>

@model IEnumerable<YallaEat.Models.Order>

@{
    ViewData["Title"] = "All Orders";
}

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-receipt text-warning me-2"></i>Global Order History</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to Admin Panel</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4">Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="px-4 py-3 fw-bold">#@order.Id</td>
                            <td>
                                <div>@order.User?.FirstName @order.User?.LastName</div>
                                <small class="text-muted">@order.User?.Email</small>
                            </td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="fw-bold text-primary">$@order.TotalAmount.ToString("0.00")</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary">@order.Status</span>
                            </td>
                            <td class="text-end px-4">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">View Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

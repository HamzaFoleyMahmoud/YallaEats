@model IEnumerable<YallaEat.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5 pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-users text-primary me-2"></i>User Management</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to Admin Panel</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4">User</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <div class="fw-bold">@user.FirstName @user.LastName</div>
                                <small class="text-muted">ID: @user.Id</small>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning">Pending</span>
                                }
                            </td>
                            <td class="text-end px-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="MakeOwner" method="post">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                            <i class="fa-solid fa-arrow-up me-1"></i>Promote to Owner
                                        </button>
                                    </form>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Deactivate</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
